# Virtual environments
venv/
.venv/
env/

# Environment variables & credentials
.env
.env.*
!.env.example

# Python compiled files & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Pytest & test cache
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/
*.log
test_results*.log

# Runtime generated outputs & reports
outputs/*
!outputs/.gitkeep
reports/
candidate_report.json
scoring_results.json

# Runtime uploaded storage (resumes & job descriptions)
storage/resumes/*
!storage/resumes/.gitkeep
storage/job_descriptions/*
!storage/job_descriptions/.gitkeep
uploads/

# Unwanted or sensitive candidate resumes in data/
data/resumes/
data/sample_resumes/Bibin_VS_Resume*
data/sample_resumes/resume_*.pdf

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
